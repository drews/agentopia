{
  "name": "agentopia",
  "version": "1.0.0",
  "description": "**Empowering self-directed productivity through agentic thought augmentation.**",
  "main": "index.js",
  "scripts": {
    "test": "npm run test:health",
    "test:health": "npx bddgen --config playwright-simple.config.ts && npx playwright test --config playwright-simple.config.ts",
    "test:health:headed": "npx bddgen --config playwright-simple.config.ts && npx playwright test --config playwright-simple.config.ts --headed",
    "test:e2e": "npx bddgen && npx playwright test",
    "test:e2e:ui": "npx bddgen && npx playwright test --ui",
    "test:e2e:debug": "npx bddgen && npx playwright test --debug",
    "test:e2e:headed": "npx bddgen && npx playwright test --headed",
    "test:e2e:update-snapshots": "npx bddgen && npx playwright test --update-snapshots",
    "bddgen": "npx bddgen",
    "report": "npx playwright show-report",
    "docker:test": "docker compose -f docker-compose.test.yml up --build --abort-on-container-exit tests",
    "docker:smoke": "docker compose -f docker-compose.test.yml up --abort-on-container-exit tests",
    "docker:test:clean": "docker compose -f docker-compose.test.yml down --volumes --remove-orphans",
    "docker:test:logs": "docker compose -f docker-compose.test.yml logs",
    "docker:test:build": "docker compose -f docker-compose.test.yml build",
    "docker:services:up": "docker compose -f docker-compose.test.yml up -d backend frontend",
    "docker:services:down": "docker compose -f docker-compose.test.yml down"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drews/agentopia.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/drews/agentopia/issues"
  },
  "homepage": "https://github.com/drews/agentopia#readme",
  "devDependencies": {
    "@playwright/test": "^1.53.2",
    "playwright-bdd": "^8.3.1"
  }
}
