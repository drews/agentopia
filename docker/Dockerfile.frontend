FROM node:18-alpine

WORKDIR /app

# Install curl for health checks
RUN apk add --no-cache curl

# Copy package files
COPY frontend/package*.json ./

# Install dependencies with cache optimization
RUN npm ci --silent

# Copy source code
COPY frontend/ ./

# Expose port
EXPOSE 3000

# Start development server with hot reload (Vite)
CMD ["npx", "vite", "--host", "0.0.0.0"]