FROM node:18-alpine

WORKDIR /app

# Install curl for health checks
RUN apk add --no-cache curl

# Copy package files
COPY frontend/spaceship-bridge/package*.json ./

# Install dependencies
RUN npm install

# Copy source code
COPY frontend/spaceship-bridge/ ./

# Expose port
EXPOSE 3000

# Re-run npm install on start: the compose node_modules volume can be
# empty/stale (e.g. after a fresh volume or a dependency bump) and would
# otherwise shadow the deps installed at image build time.
CMD ["sh", "-c", "npm install && npm start"]